# ── Database (Neon) ────────────────────────────────────────────────────────────
# Pooled connection for the app
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# Direct (unpooled) connection for migrations
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── NextAuth ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-32-char-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Create at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-openai-api-key

# ── Upstash Redis ──────────────────────────────────────────────────────────────
# Create at https://console.upstash.com → Redis → Create Database
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# ── Cloudflare R2 ──────────────────────────────────────────────────────────────
# Create bucket at https://dash.cloudflare.com → R2 → Create bucket
# API tokens at https://dash.cloudflare.com → My Profile → API Tokens
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=docmind-uploads
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# Optional: public URL if the bucket has public access enabled
# CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Backend (ingestion service) ────────────────────────────────────────────────
# URL of the document parsing/embedding backend (Python FastAPI)
BACKEND_URL=http://localhost:8000
# Shared secret for backend-to-frontend auth — generate with: openssl rand -base64 32
BACKEND_SECRET=your-32-char-backend-secret-here

# ── Optional ───────────────────────────────────────────────────────────────────
# Secret for cron job endpoints
# CRON_SECRET=your-32-char-cron-secret
NODE_ENV=development
