# Copy from root .env or fill in manually
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
BACKEND_SECRET=change-me-32-chars-minimum-required
# OpenRouter (preferred — free tier, picks best available model)
OPENROUTER_API_KEY=sk-or-your-key
# OpenAI (fallback if OPENROUTER_API_KEY is not set)
OPENAI_API_KEY=sk-proj-your-key
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=docmind-uploads

# HERALD — Knowledge Graph (optional overrides)
HERALD_ENABLED=true
HERALD_DISTILL_MAX_CHUNKS=30
HERALD_PROMOTION_THRESHOLD=3

# Ollama embedding server (override if running in Docker or remote)
# Default: http://localhost:11434/api/embeddings
# Docker example: http://host.docker.internal:11434/api/embeddings
OLLAMA_URL=http://localhost:11434/api/embeddings
